# The variables the Compose stack requires. This file documents their names —
# it deliberately carries no values, not even placeholder ones: a dummy value
# shaped like a password ("replace-with-...") is indistinguishable from a real
# one to a secret scanner, and training yourself to dismiss those alerts is how
# a genuine leak gets waved through.
#
# Generate a real .env (gitignored) with:
#
#   bash scripts/generate_secrets.sh
#
# which writes 24 bytes of CSPRNG output per value. Compose fails loudly with
# the variable's name if any of these is unset, so an empty value here cannot
# silently become a weak credential.

# Postgres superuser password for the ledger database.
# Note: baked in at first volume init — changing it later has no effect unless
# you drop the volume (docker compose down -v).
MONOLITH_POSTGRES_PASSWORD=

# Dedicated login held by the dashboard runtime. It can only SET ROLE to the
# least-privileged monolith_app group; it cannot migrate or manage roles.
MONOLITH_DATABASE_RUNTIME_PASSWORD=

# Per-module ingest bearer tokens. Each is scoped to one module, so one
# module's credential cannot be used to forge another's events.
MONOLITH_EVENT_TOKEN_MCP_SHIELD=
MONOLITH_EVENT_TOKEN_VECTOR_ANCHOR=
MONOLITH_EVENT_TOKEN_TRACE_AUDIT=

# Authenticates MCP-Shield's persisted tool-schema baseline. Rotating it
# intentionally invalidates the old baseline, which must then be re-approved.
MCP_SHIELD_KEY=

# Tenant boundary stamped on events and operator sessions.
MONOLITH_TENANT_ID=

# Protects VectorAnchor quarantine/configuration reads and mutations, plus
# TraceAudit detector-configuration reads.
MONOLITH_ADMIN_TOKEN=

# The human operator's credential for the investigation queue, and the name the
# audit trail records against their actions. Deliberately separate from the
# module tokens: those identify modules, and a module must not be able to close
# its own findings. The name is derived from the token server-side, so a caller
# cannot record someone else's name against a decision.
MONOLITH_OPERATOR_NAME=
MONOLITH_OPERATOR_TOKEN=

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# Direct deployments use a conservative shared login bucket.
OPERATOR_TRUST_PROXY_HEADERS=false

# Optional production OIDC/Supabase Auth adapter. Configure all three or none.
# Supabase issuer: https://<project-ref>.supabase.co/auth/v1
# Supabase JWKS:   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
OPERATOR_OIDC_ISSUER=
OPERATOR_OIDC_AUDIENCE=
OPERATOR_OIDC_JWKS_URL=
OPERATOR_OIDC_REQUIRE_MFA=true
OPERATOR_OIDC_DEFAULT_TENANT=

# Optional critical-event webhook. Configure both or neither. Production
# destinations must use HTTPS; loopback HTTP is allowed for local testing.
# Receivers verify HMAC-SHA256 over "<x-monolith-timestamp>.<raw body>".
MONOLITH_ALERT_WEBHOOK_URL=
MONOLITH_ALERT_WEBHOOK_SECRET=
