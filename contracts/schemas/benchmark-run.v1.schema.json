{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-black-monolith.local/contracts/benchmark-run.v1.schema.json",
  "title": "Detector benchmark run upload",
  "type": "object",
  "additionalProperties": false,
  "required": ["detectors"],
  "properties": {
    "run_at_ms": { "type": "integer", "minimum": 1, "maximum": 32503680000000 },
    "git_commit": { "type": "string", "minLength": 1, "maxLength": 64 },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/detector" }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "detector",
        "paradigm",
        "benchmark_version",
        "confusion",
        "latency_us",
        "thresholds"
      ],
      "properties": {
        "module": { "enum": ["mcp-shield", "vector-anchor", "trace-audit"] },
        "detector": { "type": "string", "minLength": 1, "maxLength": 64 },
        "paradigm": { "enum": ["threshold", "exact", "regex"] },
        "benchmark_version": { "type": "integer", "minimum": 1, "maximum": 32767 },
        "confusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tp", "fp", "tn", "fn"],
          "properties": {
            "tp": { "$ref": "#/$defs/count" },
            "fp": { "$ref": "#/$defs/count" },
            "tn": { "$ref": "#/$defs/count" },
            "fn": { "$ref": "#/$defs/count" }
          }
        },
        "latency_us": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["p50", "p95", "p99"],
              "properties": {
                "p50": { "type": "number", "minimum": 0 },
                "p95": { "type": "number", "minimum": 0 },
                "p99": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "thresholds": { "type": "object" },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
