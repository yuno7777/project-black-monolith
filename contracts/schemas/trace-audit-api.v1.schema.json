{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-black-monolith.local/contracts/trace-audit-api.v1.schema.json",
  "title": "TraceAudit API contracts",
  "$defs": {
    "generateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "tokenEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "token", "kl", "threshold"],
      "properties": {
        "type": { "const": "token" },
        "token": { "type": "string", "minLength": 1 },
        "kl": { "type": ["number", "null"], "minimum": 0 },
        "threshold": { "type": "number", "minimum": 0 }
      }
    },
    "piiEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "redacted"],
      "properties": {
        "type": { "const": "pii" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "redacted": { "type": "string", "pattern": "^\\[REDACTED:[^]]+\\]$" }
      }
    },
    "terminatedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason", "kl", "threshold", "safe_refusal"],
      "properties": {
        "type": { "const": "terminated" },
        "reason": { "const": "reasoning_divergence" },
        "kl": { "type": "number", "minimum": 0 },
        "threshold": { "type": "number", "minimum": 0 },
        "safe_refusal": { "type": "string", "minLength": 1 }
      }
    },
    "doneEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "peak_kl", "tokens"],
      "properties": {
        "type": { "const": "done" },
        "peak_kl": { "type": "number", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "errorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "error"],
      "properties": {
        "type": { "const": "error" },
        "error": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "streamEvent": {
      "oneOf": [
        { "$ref": "#/$defs/tokenEvent" },
        { "$ref": "#/$defs/piiEvent" },
        { "$ref": "#/$defs/terminatedEvent" },
        { "$ref": "#/$defs/doneEvent" },
        { "$ref": "#/$defs/errorEvent" }
      ]
    },
    "chatCompletionMessage": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "type": { "type": "string" }, "text": { "type": "string" } }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "chatCompletionRequest": {
      "type": "object",
      "required": ["messages"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chatCompletionMessage" }
        },
        "stream": { "type": "boolean" },
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "monolithAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminated", "redactions", "peak_kl"],
      "properties": {
        "terminated": { "type": "boolean" },
        "redactions": { "type": "array", "items": { "type": "string" } },
        "redaction_count": { "type": "integer", "minimum": 0 },
        "peak_kl": { "type": "number", "minimum": 0 }
      }
    },
    "chatCompletionResponse": {
      "type": "object",
      "required": ["id", "object", "created", "model", "choices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "object": { "const": "chat.completion" },
        "created": { "type": "integer", "minimum": 0 },
        "model": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "message", "finish_reason"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "message": {
                "type": "object",
                "required": ["role", "content"],
                "properties": {
                  "role": { "const": "assistant" },
                  "content": { "type": "string" }
                }
              },
              "finish_reason": { "enum": ["stop", "content_filter", "error"] }
            }
          }
        },
        "usage": { "type": "object" },
        "monolith_audit": { "$ref": "#/$defs/monolithAudit" },
        "error": { "type": "string", "minLength": 1 }
      }
    },
    "chatCompletionChunk": {
      "type": "object",
      "required": ["id", "object", "created", "model", "choices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "object": { "const": "chat.completion.chunk" },
        "created": { "type": "integer", "minimum": 0 },
        "model": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "delta"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "delta": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "content": { "type": "string" } }
              },
              "finish_reason": {
                "anyOf": [
                  { "enum": ["stop", "content_filter", "error"] },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "monolith_audit": { "$ref": "#/$defs/monolithAudit" },
        "error": { "type": "string", "minLength": 1 }
      }
    }
  }
}
