# ── Secrets / environment ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ── Rust (mcp-shield, crates/pbm-secret-boundary) ───────────────────────
target/
# Runtime-generated trusted-schema store (written relative to the CWD)
baseline_hashes.json
# Lock file serializing read-modify-write cycles on that store
baseline_hashes.json.lock
# A custom baseline path gets its own <name>.lock sibling
*.json.lock

# ── Python (vector-anchor, trace-audit, python-common) ──────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
# setuptools build artifacts (python-common is a buildable package)
build/
dist/

# ── Runtime-generated data / models ─────────────────────────────────────
chroma_store/
baseline_distribution.json
# Detector state plus its .tmp / .unreadable / .unreadable.N siblings
**/detector_state.json*
.ollama/

# ── Durable event outboxes (hold event payloads; never commit) ──────────
# SQLite outbox (vector-anchor, trace-audit) plus its -wal / -shm sidecars
*outbox.db*
# MCP-Shield JSONL spool plus its .dead / .lock / .tmp siblings
*outbox.jsonl
*outbox.dead
*outbox.lock
*outbox.tmp

# ── Node / Next.js (dashboard) ──────────────────────────────────────────
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
**/.eslintcache
npm-debug.log*

# ── Local-only agent guidance ───────────────────────────────────────────
CLAUDE.md

# ── Editor / OS / patch dirties ─────────────────────────────────────────
.DS_Store
desktop.ini
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.orig
*.rej
*~
*.bak

# ── Logs and temporary files ────────────────────────────────────────────
*.log
*.tmp

# ── Local presentation material (not part of the codebase) ──────────────
AEOS_Guard_*.pdf
build_aeos_*.py
_aeos_p*.png
build_five_project_explanations.py
output/

# ── Generated benchmark reports (per-run artifacts, uploaded not stored) ─
**/fixtures/benchmark_results.json
evaluation/results/

# ── Local Compose overrides (e.g. an alternate host port) ───────────────
docker-compose.override.yml

# ── Local protected-agent state and logs ────────────────────────────────
.agent-state/
.venv-next/
/dist/

# ── Local event outbox (host runs of the modules, not the compose stack) ─
.monolith/

# ── Throwaway native PostgreSQL cluster (scripts/native_smoke.py) ───────
/.native-pg-*/

# ── Local-only leftovers (not part of the codebase) ─────────────────────
